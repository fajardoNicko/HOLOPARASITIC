/scripts/make_stats_section_docx.py
/scripts/make_supplementary_docx.py
/scripts/make_supplementary_tables.py
/scripts/patch_discussion_docx.py
/scripts/verify_manuscript_numbers.py
/scripts/check_submission_dates.py
/scripts/extract_prompt_log.py
/scripts/logbook_entries.py
/scripts/logbook_figures.py
/scripts/make_form2a_attachment.py
/scripts/make_isef_forms.py
/scripts/make_logbook_attachments.py
/scripts/make_logbook_cover.py
/scripts/make_research_logbook.py
/scripts/make_research_plan_docx.py
/scripts/submission_info.py
/scripts/make_board_figures.py
/scripts/make_flowchart_figures.py
/scripts/make_pipeline_revised.py
/scripts/make_stats_tree.py

# Figures that are diagrams or display-board art, not results
/figures/board_*
/figures/board_photos/
/figures/methodology/fig01_pipeline*.png
/figures/methodology/fig02_dataset.png
/figures/methodology/fig03_reconstruction.png
/figures/methodology/fig07_hydraulic_flow.png
/figures/methodology/fig08b_cavitation_loop.png
/figures/methodology/fig12_stats_tree.png
/figures/methodology/fig_reticulation_concept.png

# ==========================================================================
# Run logs: redirected stdout, kept locally. The results they narrate are in
# data/*.csv and data/*.json.
# ==========================================================================
*.log
# ...except this one, which is JSON despite the extension
!data/_critloc_summary.log

