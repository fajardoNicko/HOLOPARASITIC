# ==========================================================================
# Raw source dataset — re-download, never commit
# ==========================================================================
# Matos et al. (2024) UCBG venation deposit, ~4.4 GB of per-leaf vein/node/HLD
# CSVs. Fetch it from Dryad (doi:10.5061/dryad.1g1jwsv36) and unzip it here.
# This directory also exists in git history (commits e667fe7..76febe6), which is
# why .git is ~1.6 GB; ignoring it now does not rewrite that history.
UCBG_venation_form_data/

# ==========================================================================
# Python
# ==========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ==========================================================================
# R
# ==========================================================================
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ==========================================================================
# OS / editor cruft
# ==========================================================================
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*.swp
*~
.vscode/
.idea/

# MS Office lock/owner files (e.g. ~$THODOLOGY_SEGMENTS_RRL.docx)
~$*

# ==========================================================================
# LaTeX build artifacts
# ==========================================================================
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.bbl
*.blg

# ==========================================================================
# Machine-local Claude Code config
# Grants broad auto-approval; committing it would apply it on other machines.
# ==========================================================================
.claude/settings.local.json

# ==========================================================================
# Run logs
# Every driver prints its progress to stdout; these are redirected copies of
# that, kept locally so a long run can be inspected after the fact. The results
# they narrate are already in data/*.csv and data/*.json.
# ==========================================================================
*.log
# ...except this one, which is JSON despite the extension — it is a results
# file, not narration, and is kept in the repo.
!data/_critloc_summary.log

# ==========================================================================
# Heavy binaries that are not inputs to any script
# ==========================================================================
# COMSOL model files (16 MB+ each; the FSI side-experiment, not part of the
# percolation pipeline — see COMSOL_FSI_Repair_Guide.md for how to rebuild one).
*.mph
# Vision-board exports, regenerated from VISIONBOARD.html by the browser.
VISIONBOARD*.png
VISIONBOARD*.pdf
# Photographs used only as board decoration; not measured by any script.
figures/board_photos/

# ==========================================================================
# Local-only drafts and generated exports
#
# Everything below is deliberately not pushed: either it is a working draft, or
# it is regenerated on demand by a script in scripts/. The manuscript documents
# that ARE tracked (Methodology.docx, RESULTS_DATA_PACK.docx, SECOND_PASS_AUDIT.md,
# …) are intentionally left out of this list.
# ==========================================================================
CLAUDES CUT.docx
RESULTS_REVISED.docx
APPENDIX_C_COMPUTATIONS.tex
APPENDIX_C_CHECKS.csv
FIX_LIST.md
HERO_NUMBERS.md
HERO_DECISION.md
RESULTS_AUDIT.md
REVISION_REPORT.md
COMSOL_FSI_Repair_Guide.md
MANUSCRIPT_REVISED_SECTIONS_NEW.docx
*.docx
*.xlsx
!DISTRICT STF - BIBLIOGRAPHY.docx

# Talk / teaching scripts — drafted locally, never part of the repo
CONCEPTS.md
EXPLAINER.md
METHODOLOGY_SCRIPT.md
ORAL_SCRIPT.md
PRESENTATION.md
PRESENTATION_SCRIPT.md
STUDY_MASTERY_GUIDE.md
*.html
